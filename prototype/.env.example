# ============================================================================
# 瀚川工业园能耗异常定位智能体 · 第一阶段原型配置示例
# 用法：复制本文件为 .env，按需修改（.env 不要提交到代码仓库）
# ============================================================================

# ---------------------------------------------------------------------------
# 一、大模型配置（OpenAI 兼容接口）
# ---------------------------------------------------------------------------
# provider 可选：openai / deepseek / qwen / moonshot / mock
#   - 前四个都走 OpenAI 兼容协议，区别只是 base_url 与 model 不同
#   - 填 mock 可强制走离线模拟（不需要任何 Key，用于验证链路）
LLM_PROVIDER=deepseek

# API Key。留空时程序自动降级为「离线模拟模式」，全链路仍可跑通，只是没有真实模型输出
LLM_API_KEY=

# 常见供应商的 base_url（注意大多数需要带 /v1，不要带结尾斜杠）
#   DeepSeek   https://api.deepseek.com/v1          model: deepseek-chat
#   OpenAI     https://api.openai.com/v1            model: gpt-4o-mini
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
#   Moonshot   https://api.moonshot.cn/v1           model: moonshot-v1-8k
#   本地 vLLM   http://127.0.0.1:8000/v1            model: 你部署的模型名
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 超时与生成参数
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400

# ---------------------------------------------------------------------------
# 二、Embedding 配置
# ---------------------------------------------------------------------------
# auto  = 优先本地 sentence-transformers → 其次 API → 最后离线 hash（推荐首次用 auto）
# st    = 强制本地中文模型（需 pip install sentence-transformers，首次会下载约 100MB）
# api   = 强制走 /embeddings 接口（走语义检索，效果最好）
# hash  = 强制离线哈希（无依赖、可离线，但只是"词形相似"，不是"语义相似"）
EMBEDDING_PROVIDER=auto

# 本地模型名（st 模式使用）。BGE 系列在中文检索上表现稳定，体积也较小
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# API 模式配置。留空则自动复用上面的 LLM_API_KEY 与 LLM_BASE_URL
#   OpenAI  https://api.openai.com/v1   text-embedding-3-small
#   通义     https://dashscope.aliyuncs.com/compatible-mode/v1  text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 仅 hash 模式使用的向量维度
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# 三、知识与检索参数
# ---------------------------------------------------------------------------
KB_DIR=knowledge_base
DATA_DIR=data
CACHE_DIR=.cache
OUTPUT_DIR=output

# 切片：目标长度 500 中文字符，相邻重叠 50 字符
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 最终送入 Prompt 的片段数
TOP_K=3

# ---------------------------------------------------------------------------
# 四、异常检测阈值
# 【重要】以下全部是模拟测试参数，不代表瀚川工业园已确认的验收规则
# ---------------------------------------------------------------------------
# 总分表差异率阈值（0.03 = 3%）
BALANCE_DIFF_THRESHOLD=0.03

# 参与平衡计算的最小电量（kWh），低于此值不判定，避免夜间小电量造成的比率噪声
BALANCE_MIN_ENERGY_KWH=1.0

# 倍率变化触发倍数（1.5 表示变化超过 1.5 倍或低于 1/1.5 即生成待核查事件）
RATIO_CHANGE_FACTOR=1.5
