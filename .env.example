# 瀚川工业园 · 能耗异常定位智能体 —— 环境变量样例
# 用法：cp .env.example .env 后按需修改（.env 已被 .gitignore 忽略，禁止入库）
# 说明：所有字段留空也能启动（离线模拟模式：不调用任何外部 API，规则与门禁照常执行）

# ============================== 大模型 ==============================
# openai | deepseek | qwen | moonshot | mock
# 留空 LLM_API_KEY = 离线模拟模式（确定性摘要，页面显示"离线模拟模式"角标）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60                 # 单次调用超时（秒）
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400            # 单次回复上限（费用护栏起点）
LLM_FALLBACK_MOCK=true         # LLM 不可用时降级为离线摘要，而不是报错白屏

# ============================== Embedding ==============================
# auto（优先本地模型，缺失则 hash）| hash | api | st
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1024             # 仅 hash 模式使用

# ============================== 知识库与检索 ==============================
KB_DIR=knowledge/samples       # 内建知识库目录（相对仓库根目录）
DATA_DIR=data/samples          # 模拟读数目录（真实接入时指向采集系统导出目录）
CACHE_DIR=.cache               # 索引缓存（可删，重启自动重建）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3

# ============================== 数据库 ==============================
# 默认 SQLite（单文件、WAL 模式）；换 PG 只需改连接串（代码未使用 SQLite 方言）
# DB_URL=sqlite+aiosqlite:///./hanchuan.db
# DB_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/hanchuan

# ============================== 会话 ==============================
HISTORY_ROUNDS=6               # 带入上下文的历史轮数
HISTORY_CHAR_BUDGET=3000       # 历史字符预算，超出从最旧截断

# ============================== 服务 ==============================
SERVING_HOST=127.0.0.1         # 容器内改为 0.0.0.0
SERVING_PORT=8000

# ============================== 安全与合规 ==============================
# JWT_SECRET 建议显式配置（>=32 字节）；不配置则自动生成并落盘到 .jwt_secret（已忽略）
JWT_SECRET=
LOG_RETENTION_DAYS=90          # 审计日志保留天数（阶段9 要求 90 天）
KB_UPLOAD_MAX_MB=10
UPLOADS_DIR=uploads            # 用户上传的原始文档（运行时数据，不入库，容器建议挂卷）

# ============================== 限流（阶段9）==============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240       # 单用户每分钟请求数（试点建议值，需压测校准）
RATE_LIMIT_GLOBAL_PER_MINUTE=1200

# ============================== 评测 / 回归 ==============================
# 把"今天/昨天"固定到某一天，保证回归可复现；生产留空 = 数据日+1
EVAL_CLOCK_DATE=
