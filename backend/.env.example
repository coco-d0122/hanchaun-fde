# 瀚川工业园 · 阶段4 后端配置样例
# 复制为 backend/.env 后按需修改；所有字段留空也有安全默认值（离线可演示）

# ---- 大模型（OpenAI 兼容接口；留空 = 离线模拟模式）----
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
# LLM 失败时降级为离线模拟输出（前端显示"离线模拟模式"角标）
LLM_FALLBACK_MOCK=true

# ---- Embedding（auto | hash | api | st）----
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1024

# ---- 知识库 / 检索（与阶段3一致）----
KB_DIR=knowledge_base
DATA_DIR=data
CACHE_DIR=.cache
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3

# ---- 阶段4新增 ----
